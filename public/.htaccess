# Static-hosting rules for Apache (Combell). Files under public/ are copied to
# the site root by `nuxt generate`, so this lands at the docroot. It is inert on
# the Nitro/Coolify deploy (served as a plain file), so both targets share it.

# --- AVIF content type -------------------------------------------------------
# Prerendered AVIF variants keep their source extension (/_ipx/f_avif...,*.png),
# so Apache would label them image/png. Force the right type by URL prefix. This
# is the static-host equivalent of server/middleware/avif-content-type.ts.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_ipx/f_avif" is_avif=1
</IfModule>
<IfModule mod_headers.c>
  Header set Content-Type "image/avif" env=is_avif
</IfModule>

# --- Long-cache immutable assets ---------------------------------------------
# All content-hashed or never-changed-in-place, so safe to cache hard (1yr).
# Fonts (/_fonts/) and baked OG images (/_og/) are hashed/stable too. Content
# that changes in place on deploy is handled separately below.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_nuxt/"  long_cache=1
  SetEnvIf Request_URI "^/_ipx/"   long_cache=1
  SetEnvIf Request_URI "^/images/" long_cache=1
  SetEnvIf Request_URI "^/_fonts/" long_cache=1
  SetEnvIf Request_URI "^/_og/"    long_cache=1
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=long_cache
</IfModule>

# --- Deploy-scoped content: always revalidate in the browser -----------------
# HTML, payloads, the search index and sitemap change in place on every deploy,
# so max-age=0 keeps browsers revalidating. s-maxage only speaks to a shared
# cache; nothing sits in front of the pack since Sept 2026, so it is inert but
# harmless (if a CDN is ever put back, its purge must run after every rsync).
# This restores the same intent as the (inert) routeRules in nuxt.config.ts.
# env=!long_cache so the immutable prefixes above always win.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=0, s-maxage=31536000" env=!long_cache
  </FilesMatch>
</IfModule>

# --- No trailing-slash redirect ----------------------------------------------
# `nuxt generate` writes blog/index.html, never blog.html, so a request for
# /blog is a request for a directory and mod_dir answers it with a
# DirectorySlash 301 to /blog/. Every <link rel="canonical"> and every
# sitemap.xml entry is slash-less, so that redirect would fire on the canonical
# URL of every page. Worse, Apache builds it from the Host it was given: behind
# the old Bunny CDN that was the origin hostname, so the 301 threw visitors and
# crawlers (unlighthouse included) off the site onto the raw Combell pack.
#
# The rewrite below alone is NOT enough: mod_dir's fixup hook beats mod_rewrite's
# internal redirect, so the 301 still wins. Verified against Apache 2.4 locally —
# with this Off and the rewrite on, /blog answers 200 with blog/index.html.
#
# DirectorySlash needs AllowOverride Indexes, and a pack that disallows it would
# 500 the whole site. Verified permitted on this pack with a throwaway
# subdirectory (200, not 500). Apache warns Off can expose autoindex listings at
# slash-less URLs; not a risk here — this pack returns 403 for index-less
# directories, so autoindex is off.
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

# --- Canonical host: vernaillen.com / www.vernaillen.dev -> vernaillen.dev ---
# The static site is deployed into the vernaillen.com pack; vernaillen.dev is the
# canonical hostname (site.url in nuxt.config). When .com (or its www) or
# www.vernaillen.dev resolves to this docroot, 301 it to the matching path on
# .dev. Query strings are carried over automatically. Dormant when .com is
# handled by a panel-level redirect. www.vernaillen.dev points straight at
# Combell since Sept 2026 (no CDN in front any more), so it is handled here too.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Let ACME HTTP-01 through untouched: the pack cert is one multi-SAN cert that
  # includes vernaillen.com, so Combell's challenge responder must be able to
  # serve the .com token. Redirecting it here fails that SAN and the whole cert.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTP_HOST} ^((www\.)?vernaillen\.com|www\.vernaillen\.dev)$ [NC]
  RewriteRule ^ https://vernaillen.dev%{REQUEST_URI} [R=301,L]

  # --- Extensionless URLs: serve, don't redirect -----------------------------
  # Map /blog to blog/index.html internally. Needs DirectorySlash Off above to
  # have any effect — see that block. %{REQUEST_URI} rather than a backreference
  # because the operand here is the per-directory-stripped path, while the
  # substitution wants the full URL-path.
  # Must stay AFTER the .com rule above, which terminates with [R=301,L].
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]
</IfModule>

# --- Redirects (were Nuxt routeRules; static hosts need them here) -----------
# Absolute on purpose: mod_alias expands a relative target against the request
# Host, which is not always the canonical one (vernaillen.com, www, or the
# pack's own vernaillencom.webhosting.be — behind the old Bunny CDN it was
# always the latter, and `Redirect 301 /links /` sent visitors there).
Redirect 301 /links https://vernaillen.dev/

# --- 404 ---------------------------------------------------------------------
ErrorDocument 404 /404.html
